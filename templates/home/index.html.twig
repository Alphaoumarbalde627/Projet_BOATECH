{% extends 'base.html.twig' %}

{% block title %}BOA TECH — Votre partenaire en technologie et solutions numériques{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
{% endblock %}

{% block javascripts %}
    <script type="module" src="{{ asset('build/app.js') }}"></script>
{% endblock %}

{% block body %}
    <div
        id="root"
        data-login-csrf-token="{{ login_csrf_token|default('') }}"
        data-last-username="{{ last_username|default('') }}"
        data-login-error="{{ login_error|default(false) ? '1' : '0' }}"
        data-recaptcha-site-key="{{ recaptcha_site_key|default('') }}"
        data-user-identifier="{{ user_identifier|default('') }}"
        data-logout-csrf-token="{{ logout_csrf_token|default('') }}"
    ></div>
{% endblock %}
